{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI PPT Studio Slide Scene Graph",
  "type": "object",
  "required": ["slides"],
  "properties": {
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slide_id", "width", "height", "elements"]
      }
    }
  }
}
