{
  "mcpServers": {
    "ai_ppt_studio": {
      "title": "AI PPT Studio Native Workbench",
      "description": "Read and update governed AI PPT projects and render the native Codex workbench.",
      "command": "node",
      "args": [
        "./scripts/start-mcp.mjs"
      ],
      "cwd": ".",
      "env_vars": [
        "AI_PPT_PYTHON",
        "AI_PPT_PYTHONPATH",
        "AI_PPT_IMAGE2_ADAPTER_COMMAND",
        "AI_PPT_IMAGE2_RECEIVER",
        "AI_PPT_IMAGE2_MODEL",
        "AI_PPT_IMAGE2_ADAPTER_ENV_ALLOWLIST"
      ]
    }
  }
}
