{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI PPT Studio Content Blueprint",
  "type": "object",
  "required": ["title", "audience", "goal", "slides"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "chapters": {"type": "array"},
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "slide_id",
          "title",
          "purpose",
          "claim",
          "visible_content",
          "speaker_notes",
          "source_refs",
          "material_refs"
        ]
      }
    }
  }
}
